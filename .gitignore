# dependencies and build output (recreated by npm install / npm run build)
node_modules/
dist/
*.tsbuildinfo

# secrets: Supabase keys live here — never commit
.env
.env.*
!.env.example

# browser tests (npm run test:e2e): results, report and screenshots are made fresh each run
test-results/
playwright-report/
e2e/screenshots/

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# personal editor / tool settings
.claude/settings.local.json
.vscode/
.idea/

# logs and OS junk
*.log
.DS_Store
Thumbs.db

# admin-only SQL notes (usernames, owner-level scripts) — keep local
supabase/sqleditor.md   
# Facebook post pictures (kept on this computer only)
facebook post/
